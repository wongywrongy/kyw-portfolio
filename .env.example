# Compose environment for the neo deployment. Copy to .env and fill in.
# The app's own .env.example (frontend/.env.example) is for running it directly
# with npm; this file is only read by docker compose.

# Signs Payload auth tokens. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Public origin. Compiled into the bundle at build time, so `docker compose up
# -d --build` is required after changing it.
NEXT_PUBLIC_SITE_URL=https://kyle.wongworks.dev
