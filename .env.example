# Public origin. Compiled into the pages at build time, so
# `docker compose up -d --build` is required after changing it.
NEXT_PUBLIC_SITE_URL=https://kyle.wongworks.dev

# GitHub token for the activity graph on the homepage, read at build time.
# A fine-grained token with no extra permissions is enough (public
# contributions only). Passed to the build as a secret, never baked into the
# image. Optional: leave it empty and the graph renders blank.
GITHUB_TOKEN=

# neo's Tailscale address (`tailscale ip -4`). The editor binds to it, so it is
# reachable from your other devices on the tailnet and from nowhere else.
# Leave it empty to bind to loopback only.
TAILNET_IP=

# Your user and group on neo (`id -u`, `id -g`). The editor container runs as
# this user so posts and images it saves into the checkout belong to you.
PUID=1000
PGID=1000
